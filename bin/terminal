#!/usr/bin/env bash
set -euo pipefail

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd -- "$(dirname -- "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" == /* ]] || script_source="$script_dir/$script_source"
done
repo_root="$(cd -- "$(dirname -- "$script_source")/.." && pwd)"

case "${1:-}" in
  sync|update|upgrade|check|uninstall)
    command_name="$1"
    shift
    exec "$repo_root/install.sh" "--$command_name" "$@"
    ;;
  -h|--help|help|"")
    cat <<'EOF'
Usage: terminal <command>

  sync       Apply the checked-in setup to this Mac
  update     Pull repository changes, then sync
  upgrade    Update the repository and installed tools to current versions
  check      Validate tools and managed configuration
  uninstall  Remove the managed setup (prompts before removing packages)
EOF
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Run 'terminal help' for usage." >&2
    exit 2
    ;;
esac
