# Terminal settings that work well with Neovim, Herdr, and coding-agent TUIs.
font-family = MesloLGS Nerd Font
font-size = 15
# TokyoNight Moon sits next to Catppuccin Mocha (same cool purple-blue
# night) but uses more saturated reds, greens, oranges, and cyans.
# Reload with Cmd+Shift+Comma, or Cmd+Shift+P then "Reload Config".
# Cmd+Plus only changes font size.
theme = dark:TokyoNight Moon,light:TokyoNight Day

# Lift dim ANSI colors toward WCAG-readable contrast.
# 3 is Ghostty's recommended "difficult to read" floor.
minimum-contrast = 3

# Native macOS transparency and glass effect.
background-opacity = 0.6
background-opacity-cells = true
background-blur = macos-glass-regular

macos-titlebar-style = tabs
macos-option-as-alt = true
shell-integration = detect
clipboard-read = allow
clipboard-write = allow
window-padding-x = 10
window-padding-y = 8
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
confirm-close-surface = false

# Make Option+Backspace reliable in Pi and other terminal TUIs.
keybind = alt+backspace=text:\x1b\x7f
keybind = global:ctrl+shift+space=toggle_quick_terminal
